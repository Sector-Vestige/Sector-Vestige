cmd-forcemapdebug-desc = Forces the game to start with a given map that exists on the server next round, ignoring the SV map rotation.
cmd-forcemapdebug-help = Usage: forcemapdebug <map ID>
cmd-forcemapdebug-success = Forced the game to start with map { $map } next round.
cmd-forcemapdebug-cleared = Cleared the forced map setting.
cmd-forcemapdebug-map-not-found = No map exists with ID { $map }.
cmd-forcemapdebug-hint = <map ID>
